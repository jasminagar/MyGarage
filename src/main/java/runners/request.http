### POST login and create token
POST http://localhost:7070/api/v1/auth/login
Content-Type: application/json

{
  "username": "bob10",
  "password": "1234"
}

> {%
    client.global.set("token", response.body.token);
%}

### POST for register user
POST http://localhost:7070/api/v1/auth/register
Content-Type: application/json

{
  "username": "bob100",
  "password": "1234"
}

### POST create modification for car by car id
POST http://localhost:7070/cars/2/modifications
Content-Type: application/json

{
  "name": "Nye bremser",
  "category": "REPAIR",
  "date": "2026-10-07",
  "cost": 2500,
  "description": "Nye for- og bagbremser"
}

